# Copy to .env and fill in. .env is gitignored -- never commit real values.
# This is the only file that holds anything specific to your deployment.
#
# Required. scripts/tf.py refuses to run while any of these is missing or
# still set to the example value below.

# Bucket to create. Must be globally unique across all of AWS.
S3_BUCKET=your-bucket-name

# The domain the site is served on. You must own it and be able to add DNS
# records at your registrar.
DOMAIN_NAME=mementos.example.com

# AWS CLI profile to deploy with.
AWS_PROFILE=default

# The shared password for the gate. Change it here and re-apply to change it
# on the site; no Lambda rebuild is needed.
SITE_PASSWORD=change-me

# Optional. Defaults are in infrastructure/variables.tf; setting one here
# overrides it.

# Name in the header and the browser tab. Default: Mementos
# SITE_TITLE=Mementos

# Default: ap-southeast-2
# AWS_REGION=ap-southeast-2

# Prefix for every AWS resource created. Lowercase, hyphens, no spaces.
# Default: mementos
# PROJECT_NAME=mementos

# How long a login lasts before the gate asks again, in hours. Default: 720
# SESSION_HOURS=720
